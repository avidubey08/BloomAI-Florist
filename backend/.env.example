# BloomAI Florist - Environment Configuration
# Copy this to .env and fill in your credentials

PORT=5000

# MongoDB Connection String (e.g. MongoDB Atlas)
# Leave blank to run in resilient in-memory mode out of the box
MONGO_URI=mongodb+srv://<username>:<password>@cluster0.mongodb.net/bloomai_florist?retryWrites=true&w=majority

# OpenAI API Key (Optional: for live GPT-4o-mini botanical responses)
# If left blank, the built-in intelligent botanical florist engine takes over automatically
OPENAI_API_KEY=
